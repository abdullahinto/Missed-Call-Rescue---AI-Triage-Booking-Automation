    {
      "parameters": {
        "jsCode": "// Twilio's send response overwrites $json, so this pulls the clean record\n// back from \"Build Emergency Dispatch\" and tags the final outcome before\n// it reaches the shared log.\nconst d = $('Build Emergency Dispatch').first().json;\nreturn [{\n  json: {\n    ...d,\n    action_taken: \"emergency_dispatched\"\n  }\n}];"
      },
