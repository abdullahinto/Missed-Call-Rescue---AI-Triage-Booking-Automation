        "to": "={{ $('Build Emergency Dispatch').first().json.from_number }}",
        "message": "={{ $('Build Emergency Dispatch').first().json.customer_sms }}",
        "options": {}
      },
      "id": "924badd9-dcd6-4c77-9527-91d641449f80",
      "name": "SMS Customer - Emergency Confirmation",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
