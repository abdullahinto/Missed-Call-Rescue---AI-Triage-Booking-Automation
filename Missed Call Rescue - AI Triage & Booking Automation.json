    {
      "parameters": {
        "jsCode": "// Enforces SMS-safe output: strips markdown/quotes an LLM might add, and\n// hard-caps length so the message doesn't silently split into extra\n// segments. Falls back to a coherent plain message if the AI returned\n// nothing usable, same defensive pattern as the HTML fallback in the\n// original newsletter formatter \u2014 just sized for a text message instead.\nconst { sms_text } = $('Humanize SMS for Brand Voice').first().json.output;\nconst d = $('Draft Booking Message').first().json;\n\nlet text = (sms_text || \"\").trim();\ntext = text.replace(/[*_`#]/g, \"\").replace(/^\"|\"$/g, \"\");\n\nif (text.length > 300) {\n  text = text.slice(0, 297) + \"...\";\n}\n\nif (!text) {\n  const readableType = (d.service_type || \"your call\").replace(/_/g, \" \");\n  text = `Hi, this is ${d.business_name}. Thanks for calling about ${readableType} \u2014 we'll text you shortly to find a time that works.`;\n}\n\nreturn [{\n  json: {\n    ...d,\n    customer_sms: text\n  }\n}];"
      },
