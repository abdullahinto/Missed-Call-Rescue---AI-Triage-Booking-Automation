    {
      "parameters": {
        "jsCode": "// The Triage agent is only trusted for its judgment fields (service_type,\n// urgency, summary). Everything else \u2014 phone numbers, business config,\n// calendar/SMS routing data \u2014 is carried forward from \"Check Duplicate\n// Call\" untouched, since agents echo nested/verbose fields unreliably.\nconst clean = $('Check Duplicate Call').first().json;\nconst raw = $input.first().json;\nconst decision = raw.output ? raw.output : raw;\n\nreturn [{\n  json: {\n    ...clean,\n    service_type: decision.service_type,\n    urgency: decision.urgency,\n    summary: decision.summary\n  }\n}];"
      },
      "id": "352704f2-35f7-4df2-bcf4-0ee4e6e0fbcd",
      "name": "Reconcile Triage Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4176,
        3856
      ]
    },
    {
