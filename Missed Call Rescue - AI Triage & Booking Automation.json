    {
      "parameters": {
        "jsCode": "// Spam/wrong-number calls get logged for visibility but no SMS goes out \u2014\n// texting back a robocall or wrong number just annoys a real person on the\n// other end. This node just tags the outcome before it hits the shared log.\nreturn [{\n  json: {\n    ...$json,\n    action_taken: \"no_action_spam\"\n  }\n}];"
      },
      "id": "cbbf90f4-688e-41b0-8b06-220656cfe9c5",
      "name": "Mark Spam - No Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4624,
        4128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Emergencies skip AI copywriting entirely on purpose. When someone has\n// no heat, a gas smell, or active flooding, speed and predictability beat\n// natural phrasing \u2014 this message needs to be correct on the first try,\n// every time, with zero risk of an LLM call adding latency or drifting off\n// the intended wording.\nconst d = $json;\nconst readableType = (d.service_type || \"issue\").replace(/_/g, \" \");\n\nconst techSms = `EMERGENCY \u2014 ${readableType}\\nFrom: ${d.from_number}\\nSummary: ${d.summary}\\nCall them back now.`;\nconst customerSms = `Hi, this is ${d.business_name}. We got your call about your ${readableType} and marked it urgent \u2014 a technician will call you back within 15 minutes.`;\n\nreturn [{\n  json: {\n    ...d,\n    tech_sms: techSms,\n    customer_sms: customerSms\n  }\n}];"
      },
      "id": "5bde5630-20e8-4e26-ad68-0f379648c002",
      "name": "Build Emergency Dispatch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4624,
        3856
      ]
    },
    {
      "parameters": {
        "from": "={{ $json.twilio_from_number }}",
        "to": "={{ $json.on_call_tech_phone }}",
        "message": "={{ $json.tech_sms }}",
        "options": {}
      },
      "id": "4ba69f46-33ef-4f46-8cd4-af06f88f336b",
      "name": "SMS On-Call Tech",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        4848,
        3856
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_YOUR_TWILIO_CRED_ID",
          "name": "Twilio account"
        }
      }
    },
