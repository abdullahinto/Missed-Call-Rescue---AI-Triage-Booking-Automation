    {
      "parameters": {
        "jsCode": "// Twilio retries webhooks it doesn't get a fast 200 for, so the same\n// CallSid can hit this workflow more than once. This node folds the\n// current call event, the matched business config, and the recent call\n// log together into one clean context object, and flags duplicates\n// before anything gets texted twice.\n\nconst callData = $('Missed Call Webhook').first().json.body || {};\nconst businessConfig = $('Get Business Config').first().json || {};\nconst logRows = $input.all().map(i => i.json);\n\nconst callSid = callData.CallSid || '';\nconst isDuplicate = logRows.some(row => String(row.CallSID) === String(callSid));\n\nreturn [{\n  json: {\n    call_sid: callSid,\n    from_number: callData.From || '',\n    to_number: callData.To || '',\n    transcript: callData.TranscriptionText || callData.VoicemailTranscript || '',\n    business_name: businessConfig.BusinessName || '',\n    tone_notes: businessConfig.ToneNotes || '',\n    emergency_keywords: (businessConfig.EmergencyKeywords || '')\n      .split(',').map(s => s.trim()).filter(Boolean),\n    on_call_tech_phone: businessConfig.OnCallTechPhone || '',\n    calendar_id: businessConfig.CalendarId || '',\n    owner_email: businessConfig.OwnerEmail || '',\n    twilio_from_number: businessConfig.BusinessPhone || callData.To || '',\n    is_duplicate: isDuplicate\n  }\n}];"
      },
      "id": "71260df0-d1e1-4b33-88e2-46f8b13e6024",
      "name": "Check Duplicate Call",
      "type": "n8n-nodes-base.code",
